---
version: '3'

networks:
  traefik_network:
    external:
      name: homelabos_traefik
  zulip:

services:
  database:
    image: "zulip/zulip-postgresql:14"
    networks:
      - zulip
    restart: unless-stopped
    environment:
      POSTGRES_DB: 'zulip'
      POSTGRES_USER: 'zulip'
      POSTGRES_PASSWORD: "{{lookup('password', './settings/passwords/zulip_db_password chars=ascii_letters')}}"
    volumes:
      - '{{ volumes_root }}/zulip/postgresql:/var/lib/postgresql/data:rw'

  memcached:
    image: "memcached:alpine"
    networks:
      - zulip
    restart: unless-stopped
    command:
      - "sh"
      - "-euc"
      - |
        echo 'mech_list: plain' > "$$SASL_CONF_PATH"
        echo "zulip@$$HOSTNAME:$$MEMCACHED_PASSWORD" > "$$MEMCACHED_SASL_PWDB"
        echo "zulip@localhost:$$MEMCACHED_PASSWORD" >> "$$MEMCACHED_SASL_PWDB"
        exec memcached -S
    environment:
      SASL_CONF_PATH: "/home/memcache/memcached.conf"
      MEMCACHED_SASL_PWDB: "/home/memcache/memcached-sasl-db"
      MEMCACHED_PASSWORD: "{{lookup('password', './settings/passwords/zulip_memcached_password chars=ascii_letters')}}"

  rabbitmq:
    image: "rabbitmq:4.1"
    networks:
      - zulip
    hostname: zulip-rabbit
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: 'zulip'
      RABBITMQ_DEFAULT_PASS: "{{lookup('password', './settings/passwords/zulip_rabbitmq_password chars=ascii_letters')}}"
    volumes:
      - '{{ volumes_root }}/zulip/rabbitmq:/var/lib/rabbitmq:rw'

  redis:
    image: "redis:alpine"
    networks:
      - zulip
    restart: unless-stopped
    command:
      - "sh"
      - "-euc"
      - |
        echo "requirepass '$$REDIS_PASSWORD'" > /etc/redis.conf
        exec redis-server /etc/redis.conf
    environment:
      REDIS_PASSWORD: "{{lookup('password', './settings/passwords/zulip_redis_password chars=ascii_letters')}}"
    volumes:
      - '{{ volumes_root }}/zulip/redis:/data:rw'

  zulip:
    image: "zulip/docker-zulip:11.4-0"
    networks:
      - traefik_network
      - zulip
    restart: unless-stopped
    environment:
      DB_HOST: 'database'
      DB_HOST_PORT: '5432'
      DB_USER: 'zulip'
      SSL_CERTIFICATE_GENERATION: 'self-signed'
      DISABLE_HTTPS: 'True'
      SETTING_MEMCACHED_LOCATION: 'memcached:11211'
      SETTING_RABBITMQ_HOST: 'rabbitmq'
      SETTING_REDIS_HOST: 'redis'
      # Trust the reverse proxy network so Zulip doesn't reject forwarded headers.
      # This matches the default homelabos_traefik network subnet.
      LOADBALANCER_IPS: '172.18.0.0/16'
      SECRETS_email_password: '123456789'
      SECRETS_rabbitmq_password: "{{lookup('password', './settings/passwords/zulip_rabbitmq_password chars=ascii_letters')}}"
      SECRETS_postgres_password: "{{lookup('password', './settings/passwords/zulip_db_password chars=ascii_letters')}}"
      SECRETS_memcached_password: "{{lookup('password', './settings/passwords/zulip_memcached_password chars=ascii_letters')}}"
      SECRETS_redis_password: "{{lookup('password', './settings/passwords/zulip_redis_password chars=ascii_letters')}}"
      SECRETS_secret_key: "{{lookup('password', './settings/passwords/zulip_secret_key chars=ascii_letters')}}"
      SETTING_EXTERNAL_HOST: '{% if zulip.domain %}{{ zulip.domain }}{% else %}{{ zulip.subdomain + "." + domain }}{% endif %}'
      SETTING_ZULIP_ADMINISTRATOR: 'admin@example.com'
      SETTING_EMAIL_HOST: ''  # e.g. smtp.example.com
      SETTING_EMAIL_HOST_USER: 'noreply@example.com'
      SETTING_EMAIL_PORT: '587'
      # It seems that the email server needs to use ssl or tls and can't be used without it
      SETTING_EMAIL_USE_SSL: 'False'
      SETTING_EMAIL_USE_TLS: 'True'
      ZULIP_AUTH_BACKENDS: 'EmailAuthBackend'
      # Uncomment this when configuring the mobile push notifications service
      # SETTING_PUSH_NOTIFICATION_BOUNCER_URL: 'https://push.zulipchat.com'
    volumes:
      - '{{ volumes_root }}/zulip/zulip:/data:rw'
    ulimits:
      nofile:
        soft: 1000000
        hard: 1048576
    depends_on:
      - database
      - memcached
      - rabbitmq
      - redis
{% include './labels.j2' %}
