---
version: '3'

networks:
  traefik_network:
    external: true
    name: homelabos_traefik

services:
  # Home Automation
  homeassistant:
    image: homeassistant/home-assistant:{{ homeassistant.version }}
    volumes:
      - "{{ volumes_root }}/homeassistant:/config"
      - /etc/localtime:/etc/localtime:ro
      - /etc/letsencrypt:/etc/letsencrypt
    restart: unless-stopped
    networks:
      - traefik_network
    ports:
      - 8123:8123
      - 1883:1883
      - 21063:21063
      # - 8080:8080
      - 51827:51827
{% include './labels.j2' %}
