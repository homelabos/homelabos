---
version: '3'

networks:
  traefik_network:
    external:
      name: homelabos_traefik
  nextcloud:

services:
  nextcloud-db:
{% if nextcloud.use_mariadb %}
    image: mariadb
    container_name: nextcloud_mariadb
    command: --transaction-isolation=READ-COMMITTED --binlog-format=ROW
    restart: always
{% else %}
    image: postgres:{{ nextcloud.db_version }}
    restart: unless-stopped
{% endif %}
    volumes:
{% if nextcloud.use_mariadb %}
      - "{{ volumes_root }}/nextcloud/mysql:/var/lib/mysql"
{% else %}
      - "{{ volumes_root }}/nextcloud/postgres:/var/lib/postgresql/data"
{% endif %}
    networks:
      - nextcloud
{% if not nextcloud.use_mariadb %}
    restart: unless-stopped
{% endif %}
    environment:
{% if nextcloud.use_mariadb %}
      - MYSQL_ROOT_PASSWORD={{ default_password }}
      - MYSQL_PASSWORD={{lookup('password', './settings/passwords/nextcloud_db_password chars=ascii_letters')}}
      - MYSQL_DATABASE=nextcloud
      - MYSQL_USER=nextcloud
{% else %}
      - POSTGRES_PASSWORD={{lookup('password', './settings/passwords/nextcloud_db_password chars=ascii_letters')}}
      - POSTGRES_DB=nextcloud
      - POSTGRES_USER=nextcloud
{% endif %}

  nextcloud-redis:
    image: redis:{{ nextcloud.redis_version }}
    networks:
      - nextcloud
    restart: unless-stopped

{% if nextcloud.talk_enabled | default(False) %}
  nextcloud-turn:
    image: coturn/coturn:{{ nextcloud.talk_turn_version }}
    container_name: nextcloud_coturn
    restart: unless-stopped
    # external-ip is driven ONLY here on the command line. The image default
    # --external-ip=$(detect-external-ip) is unreliable (can advertise a wrong
    # egress IP and breaks clients), and rendering it in turnserver.conf as
    # well would make coturn reject the duplicate. When talk_turn_external_ip
    # is unset, fall back to the image's auto-detect.
    command: "{% if nextcloud.talk_turn_external_ip %}--log-file=stdout -c /etc/coturn/turnserver.conf --external-ip={{ nextcloud.talk_turn_external_ip }}{% else %}--log-file=stdout -c /etc/coturn/turnserver.conf --external-ip=$(detect-external-ip){% endif %}"
    networks:
      - nextcloud
    volumes:
      - "{{ volumes_root }}/nextcloud/turnserver.conf:/etc/coturn/turnserver.conf:ro"
    ports:
      - "{{ nextcloud.talk_turn_port }}:{{ nextcloud.talk_turn_port }}/udp"
      - "{{ nextcloud.talk_turn_port }}:{{ nextcloud.talk_turn_port }}/tcp"
      - "{{ nextcloud.talk_turn_relay_min }}-{{ nextcloud.talk_turn_relay_max }}:{{ nextcloud.talk_turn_relay_min }}-{{ nextcloud.talk_turn_relay_max }}/udp"
{% endif %}

{% if nextcloud.talk_signaling_enabled | default(False) %}
  # Nextcloud Talk High-performance backend (signaling server).
  # Runs the spreed signaling server standalone (internal NATS via nats://loopback,
  # no Janus MCU) and reuses the coturn sidecar (nextcloud-turn) for TURN via the
  # TURN REST API, so it shares the same static-auth-secret. This is what clears
  # Talk's "Calls without High-performance backend can cause connectivity issues
  # and high load on devices" warning -- TURN alone does not.
  nextcloud-signaling:
    image: strukturag/nextcloud-spreed-signaling:{{ nextcloud.talk_signaling_version | default('79d6093') }}
    container_name: nextcloud_signaling
    restart: unless-stopped
    networks:
      - nextcloud
      - traefik_network
    environment:
      - HTTP_LISTEN=0.0.0.0:{{ nextcloud.talk_signaling_port | default(8080) }}
      - HASH_KEY={{ lookup('password', './settings/passwords/nextcloud_signaling_hashkey length=64 chars=ascii_letters,digits') }}
      - BLOCK_KEY={{ lookup('password', './settings/passwords/nextcloud_signaling_blockkey length=32 chars=ascii_letters,digits') }}
      - INTERNAL_SHARED_SECRET_KEY={{ lookup('password', './settings/passwords/nextcloud_signaling_internal_secret chars=ascii_letters') }}
      - BACKENDS=nextcloud
      - BACKEND_NEXTCLOUD_URLS=https://{{ service_domain }}
      - BACKEND_NEXTCLOUD_SHARED_SECRET={{ lookup('password', './settings/passwords/nextcloud_signaling_secret chars=ascii_letters') }}
      - NATS_URL=nats://loopback
      - TURN_SECRET={{ lookup('password', './settings/passwords/nextcloud_turn_secret chars=ascii_letters') }}
      - TURN_SERVERS=turn:{{ service_domain }}:{{ nextcloud.talk_turn_port | default(3478) }}?transport=udp,turn:{{ service_domain }}:{{ nextcloud.talk_turn_port | default(3478) }}?transport=tcp
      # A TURN API key is mandatory whenever TURN servers are set (spreed signaling
      # refuses to start its backend otherwise); used for the TURN REST credential
      # endpoint. No Janus MCU is deployed, so nothing else needs to know it.
      - TURN_API_KEY={{ lookup('password', './settings/passwords/nextcloud_signaling_turn_api_key chars=ascii_letters') }}
      - TRUSTED_PROXIES=172.0.0.0/8
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=homelabos_traefik"
      - "traefik.http.services.nextcloud-signaling.loadbalancer.server.scheme=http"
      - "traefik.http.services.nextcloud-signaling.loadbalancer.server.port={{ nextcloud.talk_signaling_port | default(8080) }}"
      - "traefik.http.routers.nextcloud-signaling.service=nextcloud-signaling"
      - "traefik.http.routers.nextcloud-signaling.rule=Host(`{{ nextcloud.talk_signaling_subdomain | default('signaling') }}.{{ domain }}`)"
      - "traefik.http.routers.nextcloud-signaling.entrypoints=https"
      - "traefik.http.routers.nextcloud-signaling.tls=true"
{% if traefik.dns_challenge_provider %}
      - "traefik.http.routers.nextcloud-signaling.tls.certresolver=dns"
      - "traefik.http.routers.nextcloud-signaling.tls.domains[0].main={{ domain }}"
      - "traefik.http.routers.nextcloud-signaling.tls.domains[0].sans=*.{{ domain }}"
{% else %}
      - "traefik.http.routers.nextcloud-signaling.tls.certresolver=http"
{% endif %}
{% endif %}

{% if nextcloud.talk_enabled | default(False) and nextcloud.talk_recording_enabled | default(False) %}
  # Talk Recording server (call recording). A separate ffmpeg+Firefox backend that
  # connects to the spreed signaling server (HPB) using its internal secret and
  # records the active speaker during calls. The Nextcloud server reaches its
  # control API over the recording subdomain (Traefik route); the RECORDING_SECRET
  # here must match the one registered in the spreed "recording_servers" appconfig.
  nextcloud-recording:
    image: nextcloud/aio-talk-recording:{{ nextcloud.talk_recording_version | default("20260817_082005") }}
    container_name: nextcloud_recording
    restart: unless-stopped
    networks:
      - nextcloud
      - traefik_network
    environment:
      - NC_DOMAIN={{ service_domain }}
      - HPB_DOMAIN={{ nextcloud.talk_signaling_subdomain | default('signaling') }}.{{ domain }}
      - RECORDING_SECRET={{ lookup('password', './settings/passwords/nextcloud_recording_secret chars=ascii_letters') }}
      - INTERNAL_SECRET={{ lookup('password', './settings/passwords/nextcloud_signaling_internal_secret chars=ascii_letters') }}
      - TZ={{ common_timezone }}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=homelabos_traefik"
      - "traefik.http.services.nextcloud-recording.loadbalancer.server.scheme=http"
      - "traefik.http.services.nextcloud-recording.loadbalancer.server.port=1234"
      - "traefik.http.routers.nextcloud-recording.service=nextcloud-recording"
      - "traefik.http.routers.nextcloud-recording.rule=Host(`{{ nextcloud.talk_recording_subdomain | default('recording') }}.{{ domain }}`)"
      - "traefik.http.routers.nextcloud-recording.entrypoints=https"
      - "traefik.http.routers.nextcloud-recording.tls=true"
{% if traefik.dns_challenge_provider %}
      - "traefik.http.routers.nextcloud-recording.tls.certresolver=dns"
      - "traefik.http.routers.nextcloud-recording.tls.domains[0].main={{ domain }}"
      - "traefik.http.routers.nextcloud-recording.tls.domains[0].sans=*.{{ domain }}"
{% else %}
      - "traefik.http.routers.nextcloud-recording.tls.certresolver=http"
{% endif %}
{% endif %}

  nextcloud:
    image: nextcloud:{{ nextcloud.version }}
    restart: unless-stopped
    networks:
      - traefik_network
      - nextcloud
    user: {{ uid_output.stdout }}:{{ gid_output.stdout }}
    sysctls:
      - net.ipv4.ip_unprivileged_port_start=0
      # The line above allows an unprivileged user (the uid/gid of the homelab user) to
      # listen on any port (https://github.com/nextcloud/docker/issues/359)
      # Used / needed for apache to l
    volumes:
      - "{{ volumes_root }}/nextcloud/webroot:/var/www/html"
      - "{{ volumes_root }}/nextcloud/redis-session.ini:/usr/local/etc/php/conf.d/redis-session.ini"
      - "{{ volumes_root }}/nextcloud/config:/var/www/html/config"
      - "{{ storage_dir }}/Documents/NextCloud:/data"
      - "{{ volumes_root }}/nextcloud/apps:/var/www/html/custom_apps"
      - "{{ volumes_root }}/nextcloud/themes:/var/www/html/themes"
      - "{{ storage_dir }}:/mnt/homelabos"
    environment:
{% if nextcloud.use_mariadb %}
      - MYSQL_HOST=nextcloud-db
      - MYSQL_PASSWORD={{lookup('password', './settings/passwords/nextcloud_db_password chars=ascii_letters')}}
      - MYSQL_DATABASE=nextcloud
      - MYSQL_USER=nextcloud
{% else %}
      - POSTGRES_HOST=nextcloud-db
      - POSTGRES_PASSWORD={{lookup('password', './settings/passwords/nextcloud_db_password chars=ascii_letters')}}
      - POSTGRES_DB=nextcloud
      - POSTGRES_USER=nextcloud
{% endif %}
      - UPLOAD_MAX_SIZE=10G
      - APC_SHM_SIZE=128M
      - OPCACHE_MEM_SIZE=128
      - CRON_PERIOD=15m
      - TZ={{ common_timezone }}
      - REDIS_HOST=nextcloud-redis
      - TRUSTED_PROXIES=172.0.0.0/8
      - NEXTCLOUD_ADMIN_USER={{ default_username }}
      - NEXTCLOUD_ADMIN_PASSWORD={{ default_password }}
      - NEXTCLOUD_DATA_DIR=/data
      - NEXTCLOUD_TRUSTED_DOMAINS={{ service_domain }}
      - NEXTCLOUD_UPDATE=1 # triggers the automated install on first run.
      # SMTP settings
      - SMTP_HOST={{vault.smtp.host}}
      - SMTP_SECURE='{% if vault.smtp.port == 587 %}ssl{% endif %}'

      - SMTP_PORT={{vault.smtp.port}}
      - SMTP_PASSWORD={{vault.smtp.pass}}
      - MAIL_FROM_ADDRESS={{vault.smtp.from_email}}
      - OVERWRITEHOST={{ service_domain }}
      - OVERWRITEPROTOCOL=https
    depends_on:
      - nextcloud-db
      - nextcloud-redis
{% include './labels.j2' %}
# Create a nextcloud header middleware so that values can be overwritten to achieve an A+ result from the security scan
# and remove the warnings from the setup and security overview.
# Documentation for headers: https://doc.traefik.io/traefik/middlewares/headers/
      - "traefik.http.middlewares.nextcloud-headers.headers.stsSeconds=31536000"
      - "traefik.http.middlewares.nextcloud-headers.headers.framedeny=true"
      - "traefik.http.middlewares.nextcloud-headers.headers.contentTypeNosniff=true"
      - "traefik.http.middlewares.nextcloud-headers.headers.browserXssFilter=true"
      - "traefik.http.middlewares.nextcloud-headers.headers.sslredirect=true"
      - "traefik.http.middlewares.nextcloud-headers.headers.customFrameOptionsValue=SAMEORIGIN"
# Reference documentation: https://doc.traefik.io/traefik/middlewares/redirectregex/
      - "traefik.http.middlewares.nextcloud-dav.redirectregex.regex=https://(.*)/.well-known/(card|cal)dav"
      - "traefik.http.middlewares.nextcloud-dav.redirectregex.replacement=https://$$1/remote.php/dav/"
      - "traefik.http.middlewares.nextcloud-dav.redirectregex.permanent=true"
# overwrite these middlewares to add the dav redirects only for nextcloud
# If this is needed for other roles, then it can be added to roles/homelabos_deploy/tasks/conf.d/middlewares.yaml
      - "traefik.http.routers.nextcloud-http.middlewares={% if https_only == True %}redirect@file, {% else %}{% if auth == True %}{% if authelia.enable %}authelia@file{% else %}basicAuth@file{% endif %}, {% endif %}{% endif %}customFrameHomelab@file,nextcloud-headers,nextcloud-dav"
      - "traefik.http.routers.nextcloud.middlewares={% if auth == True %}{% if authelia.enable %}authelia@file{% else %}basicAuth@file{% endif %}, {% endif %}customFrameHomelab@file,nextcloud-headers,nextcloud-dav"
