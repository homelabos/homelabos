---
version: '3'

networks:
  traefik_network:
    external:
      name: homelabos_traefik
  invidious:

services:
  invidious_db:
    image: postgres:10
    restart: unless-stopped
    networks:
      - invidious
    volumes:
      - "{{ volumes_root }}/invidious/db:/var/lib/postgresql/data"
      - "{{ volumes_root }}/invidious/repo/config:/config/sql"
      - "{{ volumes_root }}/invidious/repo/docker/init-invidious-db.sh:/docker-entrypoint-initdb.d/init-invidious-db.sh"
    environment:
      POSTGRES_DB: invidious
      POSTGRES_USER: kemal
      POSTGRES_PASSWORD: "{{ lookup('password', './settings/passwords/invidious_db_password chars=ascii_letters') }}"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER"]
  
  invidious:
    image: "quay.io/invidious/invidious:{{ invidious.version }}"
    restart: unless-stopped
    networks:
      - traefik_network
      - invidious
    depends_on:
      - invidious_db
    environment:
      INVIDIOUS_CONFIG: |
        channel_threads: 1
        check_tables: true
        hmac_key: "{{ lookup('password', './settings/passwords/invidious_hmac_key chars=ascii_letters length=64') }}"
        feed_threads: 1
        db:
          user: kemal
          dbname: invidious
          host: invidious_db
          port: 5432
          password: "{{  lookup('password', './settings/passwords/invidious_db_password chars=ascii_letters')  }}"
        full_refresh: false
        https_only: false
        registration_enabled: false
        invidious_companion:
        - private_url: "http://companion:8282/companion"
        invidious_companion_key: "{{ lookup('password', './settings/passwords/invidious_companion_key chars=ascii_letters length=16') }}"
        domain:
      # external_port:
{% include './labels.j2' %}

  companion:
    image: "quay.io/invidious/invidious-companion:{{ invidious.companion_version | default('latest') }}"
    restart: unless-stopped
    networks:
      - invidious
    depends_on:
      - invidious_db
    environment:
      SERVER_SECRET_KEY: "{{ lookup('password', './settings/passwords/invidious_companion_key chars=ascii_letters length=16') }}"
    logging:
      options:
        max-size: "1G"
        max-file: "4"
    cap_drop:
      - ALL
    read_only: true
    volumes:
      - companioncache:/var/tmp/youtubei.js:rw
    security_opt:
      - no-new-privileges:true

volumes:
  companioncache:
